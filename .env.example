# Copy to .env and fill in.

# Where players open the site, and the Docker network Traefik is on (docker network ls)
PORTAL_HOST=everlake.example.com
TRAEFIK_NETWORK=traefik

# The Everlake server's Docker network and its auth database
EVERLAKE_NETWORK=everlake_everlake
AUTH_DB_HOST=mysql
AUTH_DB_NAME=auth
AUTH_USER=everlake_portal
AUTH_PASSWORD=

# Unused invite codes one player may hold at a time (0 = no limit)
INVITES_PER_ACCOUNT=5

# Launcher builds offered after sign-in: a host folder, and the file names in it
DOWNLOADS_HOST_DIR=./downloads
DOWNLOAD_WINDOWS=Everlake-Setup.exe
DOWNLOAD_MACOS=Everlake.dmg

# Header holding the player's address behind the proxy (CF-Connecting-IP behind Cloudflare)
CLIENT_IP_HEADER=X-Forwarded-For

SITE_NAME=Everlake

# Everlake's own CDN (the cdn service). Its copy of the game files (about 89 GB) is kept in CDN_STORE_DIR, which
# must exist and belong to CDN_UID:CDN_GID before the first start. CDN_RATE_MB caps the first download (and the
# disk writes) in MB per second; 0 = no cap. CDN_OVERLAY_DIR holds our own patched builds, served first (may be
# empty). CDN_LAUNCHER_REF is the launcher branch or tag the service is built from.
CDN_PORT=8088
CDN_STORE_DIR=./cdn
CDN_OVERLAY_DIR=./cdn-overlay
CDN_RATE_MB=40
CDN_UID=950
CDN_GID=950
CDN_LAUNCHER_REF=main

# CDN_PUBLIC=true also serves the CDN on PORTAL_HOST under /tpr/ (launchers: --cdn https://PORTAL_HOST)
CDN_PUBLIC=false
